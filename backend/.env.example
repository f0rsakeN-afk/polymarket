# App
SECRET_KEY=change-me-in-production
DEBUG=false

# Frontend (Next.js) — used for CORS and magic link URLs
FRONTEND_URL=http://localhost:3000
# CORS — comma-separated, no wildcards allowed when credentials=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database — primary
DATABASE_URL=postgresql+asyncpg://myuser:mypassword@localhost:5435/mydatabase
# Read replica for 50k+ DAU — leave empty to use primary for reads (dev fallback)
DATABASE_REPLICA_URL=
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30

# Redis
REDIS_URL=redis://localhost:6382/0
REDIS_MAX_CONNECTIONS=100
CELERY_WORKER_REDIS_MAX_CONNECTIONS=20

# JWT
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRE=900
JWT_REFRESH_EXPIRE=604800

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Celery
CELERY_BROKER_URL=redis://localhost:6382/1

# Resend
RESEND_API_KEY=

# Mailtrap SMTP (dev — comment out RESEND_API_KEY to use SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@polymarket.example.com

# Referral
REFERRAL_REWARD_AMOUNT=1.0

# 2FA — separate from JWT_SECRET
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
TOTP_ENCRYPTION_KEY=change-me-in-production
TOTP_SETUP_EXPIRE_SECONDS=900
