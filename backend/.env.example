# App
APP_ENV=production
LOG_LEVEL=INFO
DEBUG=false

# Host binding
BACKEND_PORT=8000

# Frontend / CORS
FRONTEND_URL=http://localhost:3000

# Comma-separated, no spaces. Two origins because there are two apps:
#
#   3000  apps/web    - the storefront
#   3001  apps/admin  - the operator tool
#
# They share the API's cookies, so both origins must be allowed or the second app
# cannot load a session at all: the preflight fails, `/auth/me` never returns, and
# the admin app is permanently signed out with a console CORS error as the only
# clue. The port matters and is easy to forget - SameSite ignores ports, so
# localhost:3000 and localhost:3001 count as the same *site* to a cookie, which
# makes this pass locally and fail the moment a real origin differs.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional, wider allowlist used *only* by the CSRF origin check, unioned with
# CORS_ORIGINS. Leave empty unless a non-browser integration calls the API from
# an origin the front ends do not use - everything legitimate is already covered
# by CORS_ORIGINS. `*` is not honoured as "allow everything": app.py refuses it in
# CORS_ORIGINS, and honouring it here would be an easier way to disable CSRF
# protection entirely.
ALLOWED_ORIGINS=

# Database
# Host-side URLs (containers are on localhost:5433 / localhost:6380).
# docker-compose.*.yml override these with the in-network service names.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=PredictX
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5433/PredictX
DATABASE_REPLICA_URL=
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Redis
REDIS_PASSWORD=change-me
REDIS_PORT=6380
REDIS_URL=redis://:change-me@localhost:6380/0
REDIS_SENTINEL_URLS=
REDIS_SENTINEL_SERVICE_NAME=mymaster
REDIS_MAX_CONNECTIONS=100
CELERY_WORKER_REDIS_MAX_CONNECTIONS=20
CELERY_BROKER_URL=redis://:change-me@localhost:6380/1

# JWT
JWT_SECRET=change-me-in-production
SECRET_KEY=change-me-in-production
JWT_ACCESS_EXPIRE=900
JWT_REFRESH_EXPIRE=2592000

# Auth cookies • SameSite
#
# The correct value is a property of deployment topology, not of the application.
#
#   lax     - the API and both front ends share a site. Correct for local
#             development, and for a single-origin deployment.
#   strict  - as lax, but withholds the cookie even on top-level navigation.
#             Rarely what you want; a sign-in link emailed to an operator stops
#             working.
#   none    - REQUIRED when the front end is on a different *site* from the API,
#             which is the usual production shape: `example.com` and
#             `admin.example.com` against `api.example.com`.
#
# Why it cannot be debugged from the symptom: with `lax` across sites the browser
# simply never sends the cookie back. Login returns 200, `Set-Cookie` arrives,
# `/auth/me` 401s on every request, nothing is logged and nothing is redirected -
# the operator is just permanently signed out. And why it never reproduces
# locally: SameSite ignores ports, so localhost:3000, :3001 and :8000 are one
# site.
#
# `none` requires HTTPS. Browsers discard a SameSite=None cookie that is not
# Secure, which produces the same permanently-signed-out state by the opposite
# route. The app refuses to start on that pair, so this is not something to
# discover after deploying.
COOKIE_SAMESITE=lax

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
#
# Leave BOTH transports empty and email is skipped with a single warning line
# instead of retried - nothing is sent and nothing breaks. Set RESEND_API_KEY
# (keys start `re_`) or SMTP_HOST to actually deliver mail. The two are
# alternatives: SMTP_HOST wins when both are set.
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=noreply@predictx.io
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@predictx.io

# Referral
REFERRAL_REWARD_AMOUNT=1.0

# 2FA
TOTP_ENCRYPTION_KEY=change-me-in-production
TOTP_SETUP_EXPIRE_SECONDS=900

# Rate limiting (app-level)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_IP=60
RATE_LIMIT_PER_EMAIL_IP=5
RATE_LIMIT_AUTH_MAX_ATTEMPTS=5
RATE_LIMIT_AUTH_LOCKOUT_SECONDS=900

# Fees (decimals; effective taker take rate = trading + protocol)
TRADING_FEE_RATE=0.02
PROTOCOL_FEE_RATE=0.01
SPLIT_MERGE_FEE_RATE=0.02

# Error tracking (optional • unset means logs only)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
