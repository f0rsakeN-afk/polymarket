# ── App ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-64-char-random-key
DEBUG=false

# Frontend (Next.js) — used for CORS and magic link URLs
FRONTEND_URL=http://localhost:3000
# CORS — comma-separated, no wildcards when credentials=true
CORS_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# Docker: use the `postgres` service name, not localhost
DATABASE_URL=postgresql+asyncpg://myuser:mypassword@postgres:5432/mydatabase
# Read replica for 50k+ DAU — leave empty to use primary for reads
DATABASE_REPLICA_URL=
DB_POOL_SIZE=100
DB_MAX_OVERFLOW=50
DB_POOL_TIMEOUT=30

# ── Redis ───────────────────────────────────────────────────────────────────
# Docker: use the `redis` service name, not localhost
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=100
CELERY_WORKER_REDIS_MAX_CONNECTIONS=20

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRE=900
JWT_REFRESH_EXPIRE=604800

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Celery ──────────────────────────────────────────────────────────────────
# Redis used as broker — Docker service name
CELERY_BROKER_URL=redis://redis:6379/1

# ── Email ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@polymarket.example.com

# ── Referral ────────────────────────────────────────────────────────────────
REFERRAL_REWARD_AMOUNT=1.0

# ── 2FA ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
TOTP_ENCRYPTION_KEY=change-me-in-production-use-64-char-random-key
TOTP_SETUP_EXPIRE_SECONDS=900

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
