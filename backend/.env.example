# App
APP_ENV=production
LOG_LEVEL=INFO
DEBUG=false

# Host binding
BACKEND_PORT=8000

# Frontend / CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=polymarket
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://postgres:change-me@postgres:5432/polymarket
DATABASE_REPLICA_URL=
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Redis
REDIS_PASSWORD=change-me
REDIS_PORT=6380
REDIS_URL=redis://:change-me@redis:6379/0
REDIS_SENTINEL_URLS=
REDIS_SENTINEL_SERVICE_NAME=mymaster
REDIS_MAX_CONNECTIONS=100
CELERY_WORKER_REDIS_MAX_CONNECTIONS=20
CELERY_BROKER_URL=redis://:change-me@redis:6379/1

# JWT
JWT_SECRET=change-me-in-production
SECRET_KEY=change-me-in-production
JWT_ACCESS_EXPIRE=900
JWT_REFRESH_EXPIRE=604800

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=noreply@predictx.io
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@predictx.io

# Referral
REFERRAL_REWARD_AMOUNT=1.0

# 2FA
TOTP_ENCRYPTION_KEY=change-me-in-production
TOTP_SETUP_EXPIRE_SECONDS=900

# Rate limiting (app-level)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_IP=60
RATE_LIMIT_PER_EMAIL_IP=5
RATE_LIMIT_AUTH_MAX_ATTEMPTS=5
RATE_LIMIT_AUTH_LOCKOUT_SECONDS=900
