.env

# Celery Beat's schedule database. Runtime state, not source: it is written on
# every worker start, so tracking it produces a binary diff on each run and the
# -shm/-wal siblings leak alongside it.
backend/celerybeat-schedule
backend/celerybeat-schedule-shm
backend/celerybeat-schedule-wal

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Generated by harness/seed_user - contains a live credential for a throwaway
# local account. Never committed; rotating it is the point.
.e2e-credentials.json
