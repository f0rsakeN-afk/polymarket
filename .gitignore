.env

# Celery Beat's schedule database. Runtime state, not source: it is written on
# every worker start, so tracking it produces a binary diff on each run and the
# -shm/-wal siblings leak alongside it.
backend/celerybeat-schedule
backend/celerybeat-schedule-shm
backend/celerybeat-schedule-wal

# Playwright.
#
# Unanchored on purpose. The leading slash in `/test-results/` anchored these to
# the repo root, but Playwright writes into the *package* that runs it, so the
# frontend's failures, traces and screenshots were committed as tracked files
# and churned on every run - binary diffs of evidence for failures that had
# already been fixed. Anchoring them meant the ignore list silently did nothing
# in the only place these are actually written.
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Generated by harness/seed_user - contains a live credential for a throwaway
# local account. Never committed; rotating it is the point.
.e2e-credentials.json
