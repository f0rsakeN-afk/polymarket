# Same pinned version as the production Dockerfile and CI — see the note there.
FROM oven/bun:1.3.14-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends libc6-compat curl \
    && rm -rf /var/lib/apt/lists/*

# Everything is owned by the image's `bun` user (uid 1000, already present in the
# base image) rather than root.
#
# Not ceremony: the dev services bind-mount the working tree, so a dev server
# running as root writes root-owned files into the repository — and then the
# non-root `bun install` on the host cannot overwrite them. `--chown` on the COPYs
# below is what makes the mount writable from inside.
COPY --chown=bun:bun package.json bun.lock turbo.json .npmrc ./
COPY --chown=bun:bun apps/web/package.json ./apps/web/
COPY --chown=bun:bun apps/admin/package.json ./apps/admin/
COPY --chown=bun:bun packages/ui/package.json ./packages/ui/
COPY --chown=bun:bun packages/api-client/package.json ./packages/api-client/
COPY --chown=bun:bun packages/schemas/package.json ./packages/schemas/
COPY --chown=bun:bun packages/eslint-config/package.json ./packages/eslint-config/
COPY --chown=bun:bun packages/typescript-config/package.json ./packages/typescript-config/

# `--frozen-lockfile` against a manifest list that omits a workspace is how the
# admin app ends up missing its dependencies in the dev container: the install
# succeeds, the lockfile matches, and `next dev` then fails to resolve a workspace
# package that was never linked. Every `package.json` in the workspace belongs in
# this list - turbo's own graph is the source of truth for that, not this file.
RUN bun install --frozen-lockfile

COPY --chown=bun:bun . .

USER bun

EXPOSE 3000 3001

# The dev server is slow to answer on first request (it compiles on demand), so
# the start period is generous — a health check that fails while the first page is
# compiling is a health check that teaches you to ignore it.
#
# It does not restart anything (no restart policy in dev); it is here so
# `docker compose ps` says whether the server is actually up, which is the thing
# you are guessing at when nothing is on :3000.
HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=5 \
    CMD curl -sf "http://localhost:${PORT:-3000}/" || exit 1

# `--filter=web`. The `admin` service in docker-compose.dev.yml overrides this to
# `--filter=admin`, so both apps come from one image instead of two nearly
# identical ones.
CMD ["bunx", "turbo", "dev", "--filter=web", "--host", "0.0.0.0"]